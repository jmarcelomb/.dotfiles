#!/usr/bin/env bash

# Default to the OpenRouter ZDR preset. Never default to zai-coding-plan:
# it is not ZDR and every prompt (including git diffs via gen_commit_msg)
# would leave personal data on a provider without a retention policy.
# DeepSeek flash is the cheap ZDR tier; GLM stays available via OPENCODE_MODEL.
opencode run --model "${OPENCODE_MODEL:-openrouter/@preset/deepseek-flash-1017}" "$*"
