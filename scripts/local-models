#!/usr/bin/env bash
# Pause/resume the local MLX model stack so it releases the Mac mini's
# RAM/GPU when interactive work doesn't need it.
#
# 2026-11-14: mlx_lm.server is on-demand. The priority proxy (8080) spawns
# it on the first real request and unloads it after 30s of idleness, so the
# 9B weights normally cost nothing while unused. This toggle stays as the
# hard off-switch: while the flag exists the proxy answers 503 (no spawn)
# and a running backend is unloaded within one watchdog cycle.
#
# State is one flag file (~/.local/state/local-models.paused); the proxy
# (hosts/mac-mini/mlx-lm-priority-proxy.py) honours it. The Hindsight
# extraction server on :8085 is disabled entirely (extraction is remote),
# so there is nothing else to gate. Toggling works from sketchybar, Hermes,
# cron, anywhere — no bootout/bootstrap needed.
#
# The Hindsight daemon keeps running on purpose: recall/reflect work with no
# local LLM at all.
set -euo pipefail

FLAG="$HOME/.local/state/local-models.paused"
SERVICES=(com.user.mlx-lm-priority-proxy)
GUI="gui/$(id -u)"

kick_all() {
  for svc in "${SERVICES[@]}"; do
    launchctl kickstart -k "$GUI/$svc" 2>/dev/null || true
  done
}

case "${1:-status}" in
  pause)
    mkdir -p "$(dirname "$FLAG")"
    touch "$FLAG"
    kick_all
    echo "local models paused"
    ;;
  resume)
    rm -f "$FLAG"
    kick_all
    echo "local models resumed (weights load on the next request)"
    ;;
  toggle)
    if [ -f "$FLAG" ]; then "$0" resume; else "$0" pause; fi
    ;;
  status)
    if [ -f "$FLAG" ]; then echo "paused"; else echo "running"; fi
    ;;
  *)
    echo "usage: local-models pause|resume|toggle|status" >&2
    exit 2
    ;;
esac
