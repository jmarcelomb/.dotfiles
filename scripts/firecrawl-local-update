#!/bin/sh
# firecrawl-local-update — check, apply or auto-apply a firecrawl-local bump.
#
#   check      one line: up-to-date / update-available (exit 1 when behind)
#   notify     prints ONLY when a newer release exists (manual watchdog)
#   apply      build the latest release now, then restart the launchd agent
#   auto       cron entry point: silent when current, otherwise build detached
#              and report the outcome to the watch target when it finishes
#
# The binary is not in nixpkgs and has no brew formula, so darwin-rebuild never
# touches it: ~/.dotfiles/hosts/mac-mini/firecrawl-local.nix carries only the
# launchd wrapper. A cold build takes ~30 min (aws-lc-sys and friends).
#
# The clang/SDKROOT exports are required: the nix profile's `cc` is GCC, which
# fails the aws-lc-sys link step with `ld: library not found for -liconv`.
set -eu

CRATE=firecrawl-local
API="https://crates.io/api/v1/crates/$CRATE"
BIN="$HOME/.cargo/bin/$CRATE"
LABEL="io.firecrawl.local"
LOG="$HOME/.hermes/logs/firecrawl-local-update.log"
TARGET="${FIRECRAWL_WATCH_TARGET:-matrix:!_AIcu1YQKB7_AGWO8EhtwxBWa-vKAGprs97vSgUpgUY}"
SELF="$HOME/scripts/firecrawl-local-update"
PATH="/etc/profiles/per-user/$(id -un)/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.cargo/bin:$PATH"
[ -x "$HOME/hermes/hermes/hermes-agent/.hermes/bin/hermes" ] && \
  PATH="$HOME/hermes/hermes/hermes-agent/.hermes/bin:$PATH"
export PATH

installed() {
  [ -x "$BIN" ] || { echo none; return 0; }
  "$BIN" --version 2>/dev/null | awk '{print $2}'
}

latest() {
  curl -fsS --max-time 25 -H "User-Agent: hermes-firecrawl-update" "$API" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["crate"]["max_version"])'
}

# Build the latest release and restart the agent. Prints one closing line and
# returns non-zero (old binary still serving) when the build fails.
do_apply() {
  i=$(installed)
  l=$(latest)
  if [ "$i" = "$l" ]; then
    echo "already up-to-date ($i)"
    return 0
  fi
  echo "building $l (installed $i), log: $LOG"
  export SDKROOT="$(/usr/bin/xcrun --show-sdk-path)"
  export CC=/usr/bin/clang CXX=/usr/bin/clang++
  export CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER=/usr/bin/clang
  if ! cargo install "$CRATE" >>"$LOG" 2>&1; then
    echo "build failed, still serving $i; see $LOG"
    return 1
  fi
  launchctl kickstart -k "gui/$(id -u)/$LABEL"
  n=0
  while [ "$n" -lt 10 ]; do
    sleep 2
    n=$((n + 1))
    curl -fsS --max-time 3 http://127.0.0.1:3002/health >/dev/null 2>&1 && break
  done
  health=$(curl -fsS --max-time 5 http://127.0.0.1:3002/health || echo DOWN)
  echo "now running $(installed), health: $health"
}

case "${1:-check}" in
  check)
    i=$(installed); l=$(latest)
    if [ "$i" = "$l" ]; then
      echo "up-to-date installed=$i latest=$l"; exit 0
    fi
    echo "update-available installed=$i latest=$l"; exit 1
    ;;
  notify)
    # Silence is the normal answer, and a crates.io hiccup must not become a
    # delivery error either.
    i=$(installed) || exit 0
    l=$(latest 2>/dev/null) || exit 0
    [ "$i" = "$l" ] && exit 0
    printf 'firecrawl-local %s disponível (instalado %s). Aplicar com: ~/scripts/firecrawl-local-update apply\n' "$l" "$i"
    ;;
  apply)
    do_apply
    ;;
  auto)
    # Cron entry point: stay silent unless there is work, and hand the ~30 min
    # build to a detached child so the scheduler returns at once.
    i=$(installed) || exit 0
    l=$(latest 2>/dev/null) || exit 0
    [ "$i" = "$l" ] && exit 0
    nohup "$SELF" _auto-run "$i" "$l" >>"$LOG" 2>&1 &
    ;;
  _auto-run)
    from=${2:-?}; to=${3:-?}
    if out=$(do_apply 2>&1); then
      msg="firecrawl-local atualizado $from -> $to. $(printf '%s' "$out" | tail -n 1)"
    else
      msg="firecrawl-local: build de $to falhou, continua em $(installed). Log: $LOG"
    fi
    printf '%s\n' "$msg" >>"$LOG"
    hermes send -t "$TARGET" -q "$msg" || printf 'send failed: %s\n' "$msg" >>"$LOG"
    ;;
  *)
    echo "usage: $0 [check|notify|apply|auto]" >&2; exit 2
    ;;
esac
